# deploy/pi/.env — settings for the Pi stack (bootstrap.sh copies this file to
# .env once; edit .env, then: docker compose -f deploy/pi/docker-compose.yml up -d)

# Test phases of the real-engine stand (see README → «Тестовый стенд»):
#   A: usque (WARP) only        B: + DNS through WARP        C: + nfqws2
NUXK_ENABLE_USQUE=1
NUXK_ENABLE_DNS_GLUE=0
NUXK_ENABLE_NFQWS2=0

# Fixed access code for the installer form (empty = random, see `logs installer`)
NUXK_INSTALLER_CODE=

# nuxk-controller (:4200) — the full web UI for nuxk-core on the ROUTER.
# Enable once the router is installed: uncomment COMPOSE_PROFILES and fill in
# the router's address and its API_TOKEN (shown by the installer, also in
# /opt/etc/nuxk/nuxk.conf on the router).
#COMPOSE_PROFILES=controller
AGENT_URL=http://192.168.2.1:4141
AGENT_TOKEN=
# Login token for the controller UI (empty = generated once, see
# `docker compose -f deploy/pi/docker-compose.yml logs controller`)
CONTROLLER_TOKEN=
