# deploy/pi/.env — settings for the development stack on a Pi (bootstrap.sh copies this file to
# .env once; edit .env, then: docker compose -f deploy/pi/docker-compose.yml up -d)

# Test phases of the real-engine stand (see README → «Тестовый стенд»):
#   A: usque (WARP) only        B: + DNS through WARP        C: + nfqws2
NUXK_ENABLE_USQUE=1
NUXK_ENABLE_DNS_GLUE=0
NUXK_ENABLE_NFQWS2=0

# nuxk-controller (:4200) — the full web UI for nuxk-core on the ROUTER.
# Enable once the router is installed: uncomment COMPOSE_PROFILES, start the
# stack and open http://<pi>:4200 — a setup wizard asks for the admin
# password, then connects the router by its address and root login/password.
#COMPOSE_PROFILES=controller
# Optional, instead of the wizard's router step: the router's agent and its
# API_TOKEN from /opt/etc/nuxk/nuxk.conf (used only while nothing is stored).
AGENT_URL=
AGENT_TOKEN=
