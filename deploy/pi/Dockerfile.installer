# nuxk-installer image for the Raspberry Pi stack (deploy/pi). Builds the
# router payload from source — nuxk-core for every router arch, the lite web
# build, the nfqws2 adapter shim, the usque-keenetic ipk (WARP) — embeds it,
# and runs the installer form.
#
#   docker compose -f deploy/pi/docker-compose.yml up -d --build installer
#   docker compose -f deploy/pi/docker-compose.yml logs installer   # access code

FROM node:22-alpine AS web
WORKDIR /src
COPY nuxk-web/package.json nuxk-web/package-lock.jso[n] ./
RUN npm install --no-audit --no-fund
COPY nuxk-web/ ./
RUN npm run build:lite                      # -> /src/dist-lite, no token baked in

FROM golang:1.24-alpine AS core
WORKDIR /src
COPY nuxk-core/ ./
COPY VERSION /VERSION
ARG COMMIT=unknown
RUN for t in mips:mips mipsle:mipsel arm64:aarch64 amd64:x86_64; do \
      goarch=${t%%:*}; name=${t##*:}; \
      CGO_ENABLED=0 GOOS=linux GOARCH=$goarch GOMIPS=softfloat go build \
        -ldflags "-s -w -X main.version=$(cat /VERSION) -X main.commit=${COMMIT}" \
        -o /payload/nuxk-core-$name . || exit 1; \
    done

FROM alpine:3.20 AS usque
RUN apk add --no-cache make curl unzip tar
WORKDIR /src
COPY engines/nuxk-usque/ ./
RUN make pkg-mips pkg-mipsel pkg-aarch64 && mkdir -p /payload && \
    for a in mips mipsel aarch64; do \
      cp out/tmp/usque-keenetic_$(cat VERSION)_$a-3.*.ipk /payload/usque-keenetic-$a.ipk || exit 1; \
    done

FROM golang:1.24-alpine AS installer
WORKDIR /src
COPY nuxk-installer/go.mod nuxk-installer/go.sum ./
RUN go mod download
COPY nuxk-installer/ ./
COPY --from=core /payload/ ./payload/
COPY --from=usque /payload/ ./payload/
COPY --from=web /src/dist-lite ./payload/web
COPY nuxk-core/fs/opt/etc/init.d/S99nuxk-core engines/nuxk-nfqws2/S51nfqws2-nuxk engines/nuxk-xray/S52xray-nuxk ./payload/
COPY VERSION ./payload/VERSION
RUN CGO_ENABLED=0 go build -ldflags "-s -w" -o /nuxk-installer . && /nuxk-installer -version

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=installer /nuxk-installer /usr/bin/nuxk-installer
EXPOSE 4300
ENTRYPOINT ["/usr/bin/nuxk-installer"]
CMD ["-listen", "0.0.0.0:4300"]
