# nuxk-controller for the Pi (deploy/pi): the full web UI, metric history and
# the plugin host for the nuxk-core agent on the router.
#
#   COMPOSE_PROFILES=controller in deploy/pi/.env; the web UI's setup wizard
#   does the rest (admin password, router connection)
#
# The container starts as root only for `supervise`: it runs the web/API as
# nobody and each plugin with just the capabilities its plugin.json lists
# (see nuxk-controller/plugin.go). Python and the network tools are here for
# plugins (GP: zapret2 blockcheck2).

FROM node:22-alpine AS web
WORKDIR /src
COPY nuxk-web/package.json nuxk-web/package-lock.jso[n] ./
RUN npm install --no-audit --no-fund
COPY nuxk-web/ ./
RUN npm run build                           # full build -> /src/dist, no token baked in

FROM golang:1.24-alpine AS build
WORKDIR /src
COPY nuxk-controller/ ./
COPY VERSION /VERSION
ARG COMMIT=unknown
RUN CGO_ENABLED=0 go build -ldflags "-s -w -X main.version=$(cat /VERSION) -X main.commit=${COMMIT}" \
      -o /nuxk-controller . && /nuxk-controller -version

FROM debian:bookworm-slim
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates curl python3 python3-venv iptables nftables ipset dnsutils procps iproute2 bsdextrautils \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /nuxk-controller /usr/bin/nuxk-controller
COPY --from=web /src/dist /usr/share/nuxk-web
COPY nuxk-controller/plugins/ /usr/share/nuxk/plugins/
# owned by nobody (the web/API process); a fresh named volume copies this
RUN mkdir -p /var/lib/nuxk-controller && chown 65534:65534 /var/lib/nuxk-controller && chmod 711 /var/lib/nuxk-controller
ENV WEB_ROOT=/usr/share/nuxk-web DATA_DIR=/var/lib/nuxk-controller LISTEN=:4200
EXPOSE 4200
ENTRYPOINT ["/usr/bin/nuxk-controller"]
CMD ["supervise"]
