#!/bin/sh

PATH=/opt/sbin:/opt/bin:/opt/usr/sbin:/opt/usr/bin:/usr/sbin:/usr/bin:/sbin:/bin

NAME="nuxk-core"
BIN="/opt/usr/bin/nuxk-core"
CONFIG="/opt/etc/nuxk/nuxk.conf"
PIDFILE="/opt/var/run/nuxk-core.pid"
# nuxk-core writes and rotates this itself (2 × 512 KiB at most); stderr only
# catches a crash, into its own small file.
LOGFILE="/opt/var/log/nuxk-core.log"
CRASHLOG="/opt/var/log/nuxk-core.crash"
LOG_MAX_BYTES=65536
# Soft heap cap: the Go runtime collects harder near it instead of growing.
export GOMEMLIMIT="${GOMEMLIMIT:-48MiB}"

fn_running() {
    [ -f "$PIDFILE" ] || return 1
    kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null
}

fn_rotate_log() {
    [ -f "$CRASHLOG" ] || return 0
    sz=$(wc -c <"$CRASHLOG" 2>/dev/null) || sz=0
    [ "${sz:-0}" -gt "$LOG_MAX_BYTES" ] || return 0
    tail -c $((LOG_MAX_BYTES / 2)) "$CRASHLOG" >"$CRASHLOG.tmp" 2>/dev/null && mv "$CRASHLOG.tmp" "$CRASHLOG"
    rm -f "$CRASHLOG.tmp"
}

fn_start() {
    if fn_running; then
        echo "$NAME already running (PID $(cat "$PIDFILE"))" >&2
        return 1
    fi
    mkdir -p "$(dirname "$PIDFILE")" "$(dirname "$LOGFILE")"
    fn_rotate_log
    echo "Starting $NAME..."
    start-stop-daemon -S -b -m -p "$PIDFILE" -x /bin/sh -- -c \
        "exec \"$BIN\" -config \"$CONFIG\" -log \"$LOGFILE\" >/dev/null 2>>\"$CRASHLOG\""
    sleep 1
    fn_running && echo "Started $NAME" || { echo "Failed to start $NAME" >&2; return 1; }
}

fn_stop() {
    if ! fn_running; then
        echo "$NAME is not running" >&2
        return 1
    fi
    echo "Stopping $NAME..."
    start-stop-daemon -K -p "$PIDFILE" && rm -f "$PIDFILE"
    echo "Stopped $NAME"
}

case "$1" in
start)   fn_start ;;
stop)    fn_stop ;;
restart) fn_stop; sleep 1; fn_start ;;
status)  fn_running && echo "$NAME is running (PID $(cat "$PIDFILE"))" || echo "$NAME is stopped" ;;
*)       echo "Usage: $0 {start|stop|restart|status}" ;;
esac
