#!/bin/sh
# Fake S52xray-nuxk for local end-to-end testing of nuxk-core without a router.
#   nuxk-core -config testdata/nuxk.conf -debug
# State toggles via testdata/mock.xray.state ("up" or "down") — its own file,
# so stopping one mock engine doesn't stop the other. set-config reads what
# nuxk-core sends — "key value" meta lines, "---", then config.json — keeps
# the meta in testdata/mock.xray-meta (info shows it) and the config in
# testdata/mock.xray-config.

DIR="$(dirname "$0")"
STATE_FILE="$DIR/mock.xray.state"
CONFIG_FILE="$DIR/mock.xray-config"
META_FILE="$DIR/mock.xray-meta"
[ -f "$STATE_FILE" ] || echo up >"$STATE_FILE"
STATE=$(cat "$STATE_FILE")
meta() { sed -n "s/^$1 //p" "$META_FILE" 2>/dev/null | head -n 1; }

case "$1" in
start)     echo up   >"$STATE_FILE" ;;
stop)      echo down >"$STATE_FILE" ;;
restart)   echo up   >"$STATE_FILE" ;;
set-config)
    : >"$META_FILE"
    : >"$CONFIG_FILE"
    head=1
    while IFS= read -r line || [ -n "$line" ]; do
        if [ -n "$head" ]; then
            if [ "$line" = "---" ]; then head=""; else printf '%s\n' "$line" >>"$META_FILE"; fi
        else
            printf '%s\n' "$line" >>"$CONFIG_FILE"
        fi
    done
    echo up >"$STATE_FILE"
    echo applied
    ;;
info)
    if [ "$STATE" = "up" ]; then
        RUN=1; TUN=connected; PID=$$
    else
        RUN=0; TUN=stopped; PID=
    fi
    cat <<EOF
name XRAY
version.xray 26.3.27
version.pkg nuxk
service.running $RUN
service.pid $PID
service.uptime_s 300
tunnel.state $TUN
iface.name opkgtun1
config.server $(meta server)
config.endpoint $(meta endpoint)
config.security $(meta security)
config.network $(meta network)
config.sni $(meta sni)
config.fingerprint $(meta fingerprint)
config.flow $(meta flow)
traffic.rx_bytes $((RANDOM * 5000))
traffic.tx_bytes $((RANDOM * 800))
EOF
    ;;
probe)
    echo "server $(meta server)"
    if [ "$STATE" = "up" ] && [ -s "$META_FILE" ]; then
        echo "ok 1"
        echo "egress_ip 203.0.113.9"
        echo "rtt_ms 137"
    else
        echo "ok 0"
        echo "reason stopped"
    fi
    echo "ts $(date +%s)"
    ;;
*) echo "usage: $0 {start|stop|restart|set-config|info|probe}" ;;
esac
