{
  "name": "nuxk-web",
  "private": true,
  "version": "0.5.0-beta.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "build:lite": "vite build --mode lite --outDir dist-lite",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "gen:api": "openapi-typescript ../nuxk-core/api/openapi.yaml -o src/lib/schema.d.ts",
    "check:api": "npm run gen:api && npm run gen:gp && git diff --exit-code -- src/lib/schema.d.ts src/lib/gp-schema.d.ts",
    "gen:gp": "openapi-typescript ../nuxk-controller/plugins/gp/openapi.json -o src/lib/gp-schema.d.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "openapi-typescript": "7.13.0",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
