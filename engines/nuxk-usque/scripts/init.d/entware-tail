#!/bin/sh

fn_start() {
    if fn_is_running; then
        echo "Service $NAME is already running" >&2
        return 1
    fi

    fn_validate_config || return 1
    fn_resolve_tun_interface_config || return 1
    fn_check_tun_interface || return 1
    fn_create_session_if_required || return 1

    fn_acquire_tun_inerface || return 1

    fn_rotate_log
    fn_ensure_hooks
    fn_write_run_wrapper "$(fn_daemon_args)"

    echo "Starting $NAME service..."
    # usque requires root for creating the tun interface
    start-stop-daemon -S -b -m -p "$PIDFILE" -x "$RUN_WRAPPER" || {
        echo "Failed to start $NAME service" >&2
        rm -f "$PIDFILE"
        fn_stop_internal
        return 1
    }

    fn_setup_tun_interface || {
        fn_stop_internal
        return 1
    }

    if fn_hooks_active; then
        fn_write_state disconnected start
    else
        fn_write_state unknown start
    fi

    fn_create_running_config
    echo "Started $NAME service"
}

fn_stop_internal() {
    echo "Stopping $NAME service..."
    fn_release_tun_interface
    fn_remove_running_config

    start-stop-daemon -K -p "$PIDFILE" && rm -f "$PIDFILE"
    rm -f "$RUN_WRAPPER"
    fn_write_state stopped stop

    echo "Stopped $NAME service"
}

fn_stop() {
    if ! fn_is_running; then
        echo "Service $NAME is not running" >&2
        return 1
    fi

    fn_stop_internal
}

fn_reregister() {
    echo "Re-registering $NAME device key..."
    local was_running=0
    fn_is_running && was_running=1

    [ "$was_running" = "1" ] && fn_stop_internal

    fn_remove_session
    fn_reset_state

    fn_create_session || {
        echo "Re-registration failed" >&2
        return 1
    }

    if [ "$was_running" = "1" ]; then
        fn_start
    fi
    echo "Re-registration done"
}

case "$1" in
start)
    fn_start
    ;;
stop)
    fn_stop
    ;;
status)
    fn_status
    ;;
restart)
    fn_stop
    fn_start
    ;;
reregister)
    fn_reregister
    ;;
info)
    fn_info
    ;;
probe)
    fn_probe
    ;;
_event)
    # called by the usque --on-connect / --on-disconnect hooks
    fn_write_state "${2:-unknown}" "${3:-}"
    fn_rotate_log
    ;;
*)
    echo "Usage: $0 {start|stop|restart|status|reregister|info|probe}"
    ;;
esac
